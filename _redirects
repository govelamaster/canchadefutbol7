# Cloudflare Pages _redirects
# Format: source destination [status]

# pSEO URLs: CF Pages auto-sirve .html cuando pides la URL limpia.
# No agregar reglas /pagina → /pagina.html con status 200 — causan loop con
# el HTML auto-strip de CF Pages. Solo agregar reglas aquí si son 301 reales.

# Old URLs from sportmaster.com.mx redirected to home
/canchas/futbol-7/*       /                 301
/canchas/futbol-7         /                 301
/canchas/futbol-5/*       /                 301
/canchas/futbol-11/*      /                 301
/canchas/futbol-rapido/*  /                 301
/canchas/*                /                 301

# Slug viejo con "una" (89 páginas de ciudad lo enlazaban) → página real de costo
/cuanto-cuesta-una-cancha-de-futbol-7/  /cuanto-cuesta-cancha-futbol-7/  301
/cuanto-cuesta-una-cancha-de-futbol-7   /cuanto-cuesta-cancha-futbol-7/  301

# PDF cache-bust: viejo -> nuevo (v2)
/la-escuela-es-nuestra/guia-la-escuela-es-nuestra-2026.pdf  /la-escuela-es-nuestra/guia-la-escuela-es-nuestra-2026-v2.pdf  301

# URL SEO principal para alumbrado deportivo
/alumbrado-canchas/  /alumbrado-para-canchas-de-futbol/  301

# URL fantasma (CF Pages servía la home con imágenes rotas) → precio real
/precios-pasto-sintetico-para-canchas/  /pasto-sintetico-para-cancha-de-futbol-precio-m2/  301
/precios-pasto-sintetico-para-canchas   /pasto-sintetico-para-cancha-de-futbol-precio-m2/  301
